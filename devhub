#!/bin/sh
# devhub from Git Bash or WSL (Windows Python under Git Bash, python3 in WSL).
# MSYS path conversion off: remote paths like /userdata/... must reach devhub unchanged.
if [ -z "$MSYSTEM" ] && command -v python3 >/dev/null 2>&1; then exec python3 "$(dirname "$0")/devhub.py" "$@"; fi
d="$(cd "$(dirname "$0")" && pwd -W)"
MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' exec python "$d/devhub.py" "$@"
